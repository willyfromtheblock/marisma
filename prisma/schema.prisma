// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "dart run orm"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model PrismaAddress {
  address String @id @unique
  status String
  confirmedBalance Int
  unconfirmedBalance Int
  utxos PrismaUtxo[]
  utxoHistory String[]
  needsUpdating Boolean
}

model PrismaBlock {
  id Int @id @unique
  hash String
  blocktime Int
}

model PrismaUtxo {
  @@id([txid, txpos])
  txid String
  txpos Int
  block Int
  value Float
  address PrismaAddress @relation(fields: [addressId], references: [address])
  addressId String
  flaggedForDelete Boolean @default(false)
}