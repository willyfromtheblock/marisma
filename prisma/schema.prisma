// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "dart run orm"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model PrismaAddress {
  address String @id @unique
  status String
  confirmedBalance Int
  unconfirmedBalance Int
  utxoHistory String[]
  utxos Int[]
  needsUpdating Boolean
}

model PrismaBlock {
  id Int @id @unique
  hash String
  blocktime Int
}

model PrismaUtxo {
  @@id([txid, txpos])
  id Int @default(autoincrement())
  txid String
  txpos Int
  block Int
  value Float
  address String[]
  flaggedForDelete Boolean @default(false)
}